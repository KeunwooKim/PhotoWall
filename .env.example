# Backend (optional — without these, guest walls stay in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist (server only)
ADMIN_USER_IDS=
# ADMIN_EMAILS=you@example.com

# Public site origin (optional)
# NEXT_PUBLIC_SITE_URL=https://photowall.kr

# Rate limit (optional — in-memory fallback if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron bearer token
CRON_SECRET=

# Ads (optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=
# NEXT_PUBLIC_ADSENSE_SLOT_LANDING=

# Discord alerts (optional)
DISCORD_WEBHOOK_URL=
DISCORD_INQUIRY_WEBHOOK_URL=
# DISCORD_NOTIFY_ERRORS=1
