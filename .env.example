# Supabase (optional — 없으면 링크 인코딩 방식으로 공유)
# Supabase Dashboard → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth — Google Cloud Console 값은 Supabase Dashboard → Authentication → Providers → Google 에 입력

# ── Supabase SQL (순서대로 1회 실행) ──
# 1. supabase/schema.sql
# 2. supabase/auth-migration.sql
# 3. supabase/storage-migration.sql
# 4. supabase/social-migration.sql
# 5. supabase/shared-walls-migration.sql
# 6. supabase/privacy-invites-migration.sql
# 7. supabase/security-hardening-migration.sql
# 8. supabase/admin-inquiries-migration.sql
# 9. supabase/admin-rls-migration.sql
#    → insert into app_admins (user_id) values ('YOUR-UUID');
# 10. supabase/storage-private-migration.sql   ← 앱 배포 후 실행 (private Storage)
# 11. supabase/walls-select-rls-migration.sql  ← walls SELECT RLS 강화
# 12. supabase/realtime-broadcast-migration.sql  ← 공동벽 Realtime 수신 안 될 때 (선택)
# 13. supabase/profiles-plan-migration.sql       ← 플러스(premium) + plan_expires_at(기간제)
# 14. supabase/profiles-theme-migration.sql      ← UI 테마/색 조합 동기화
# 15. supabase/ops-hardening-migration.sql       ← 문의 회신·inbox·QR import 집계·제휴 파이프라인
# 16. supabase/storage-pending-delete-migration.sql ← 벽 저장 후 사진 유예 삭제 큐
# 17. supabase/social-insert-access-migration.sql ← likes/guestbook INSERT를 벽 접근 규칙에 맞춤
# 18. supabase/sticker-packs-migration.sql       ← UGC 스티커팩(배포·심사·설치) + sticker-assets 버킷
# 19. supabase/ads-feature-flags-migration.sql   ← house_banners / adsense 플래그 시드 (선택)
# 20. supabase/inquiries-insert-rls-fix.sql     ← 문의 insert().select()용 SELECT own 정책

# ── Admin (서버 전용 — Vercel Production, .env.local) ──
# Supabase Dashboard → Authentication → Users 에서 본인 UUID 확인
ADMIN_USER_IDS=your-supabase-user-uuid
# Optional alternate allowlist (comma-separated emails). Prefer ADMIN_USER_IDS.
# ADMIN_EMAILS=you@example.com
# Supabase Dashboard → Project Settings → API → service_role (클라이언트 노출 금지)
# 공동벽·친구 벽 사진 signed URL 발급에 필요 (없으면 본인 사진만 미리보기 가능)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google 로그인 (프로덕션) 설정 체크리스트 ──
#
# 1) Supabase → Authentication → URL Configuration  ★ 가장 중요
#    Site URL:        https://photowall.kr   ← localhost면 프로덕션 로그인 후 localhost로 감
#    Redirect URLs:
#      http://localhost:3000/auth/callback
#      https://photowall.kr/auth/callback
#
# 2) Supabase → Authentication → Providers → Google (Enabled)
#    Client ID / Secret: Google Cloud Console OAuth 2.0 클라이언트 값
#
# 3) Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트
#    승인된 JavaScript 원본:
#      http://localhost:3000
#      https://photowall.kr
#    승인된 리디렉션 URI (Supabase callback만 — 앱 URL 아님):
#      https://YOUR-PROJECT.supabase.co/auth/v1/callback
#
# 4) 서버/호스팅 Environment Variables (Production)
#    NEXT_PUBLIC_SUPABASE_URL
#    NEXT_PUBLIC_SUPABASE_ANON_KEY
#    ADMIN_USER_IDS
#    SUPABASE_SERVICE_ROLE_KEY
#    NEXT_PUBLIC_SITE_URL=https://photowall.kr   (verify 스크립트·절대 URL용, 선택)

# ── Rate limit (프로덕션 필수 — 없으면 인스턴스 메모리 fallback, /api/health degraded) ──
# Upstash Console → Redis → REST URL / TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron (Storage orphan sweeper) ──
# Authorization: Bearer $CRON_SECRET  for GET /api/cron/storage-orphans
# Vercel Cron uses CRON_SECRET automatically when set; PM2: curl with header
CRON_SECRET=

# ── Analytics (optional — Plausible) ──
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=photowall.kr
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ── Google AdSense (site verification / Auto ads) ──
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9751470689295736
# Display ad unit slot IDs (AdSense → 광고 단위별). Required for fixed placement.
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=3720420980
# NEXT_PUBLIC_ADSENSE_SLOT_LANDING=3720420980
# ads.txt is generated from the client ID at /ads.txt

# ── Wall canvas renderer ──
# Default: pixi (WebGL viewport-sized). Rollback to Konva Canvas2D: konva
# NEXT_PUBLIC_WALL_RENDERER=pixi
# NEXT_PUBLIC_WALL_RENDERER=konva

# ── Discord ops alerts (optional) ──
# Discord 채널 → 설정 → 연동 → 웹후크
# 신규 프로필 생성 시 알림 — auth 콜백(신규 가입) + ensureProfile insert
# 앱 오류(captureException + 처리되지 않은 서버 요청 오류)도 한국어 요약 카드로 전송 (프로덕션 기본 ON)
# 로컬에서 오류 알림까지 받으려면 DISCORD_NOTIFY_ERRORS=1
DISCORD_WEBHOOK_URL=
# 문의·신고 전용 웹후크 (없으면 DISCORD_WEBHOOK_URL 사용)
DISCORD_INQUIRY_WEBHOOK_URL=
# DISCORD_NOTIFY_ERRORS=1