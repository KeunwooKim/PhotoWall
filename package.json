{
  "name": "photowall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:prod": "bash scripts/start-production.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:supabase": "node scripts/verify-supabase-migrations.mjs",
    "verify:wall-omni": "npx --yes tsx scripts/verify-wall-omni.ts",
    "verify:wall-realtime": "npx --yes tsx scripts/verify-wall-realtime.ts",
    "verify": "npm run typecheck && npm run lint && npm run verify:wall-omni && npm run verify:wall-realtime",
    "audit:deps": "npm audit --audit-level=high",
    "stickers:trim-mudo": "node scripts/trim-mudo-stickers.mjs",
    "stickers:catalog-mudo": "node scripts/trim-mudo-stickers.mjs --catalog-only",
    "stickers:process-summer": "node scripts/process-photowall-stickers.mjs summer",
    "stickers:process-basic": "node scripts/process-photowall-stickers.mjs basic",
    "stickers:process-autumn": "node scripts/process-photowall-stickers.mjs autumn",
    "stickers:process-cafe": "node scripts/process-photowall-stickers.mjs cafe",
    "stickers:process-spring": "node scripts/process-photowall-stickers.mjs spring",
    "stickers:process-winter": "node scripts/process-photowall-stickers.mjs winter",
    "stickers:process-party": "node scripts/process-photowall-stickers.mjs party",
    "stickers:process-cute": "node scripts/process-photowall-stickers.mjs cute",
    "stickers:process-daku": "node scripts/process-photowall-stickers.mjs daku",
    "stickers:process-love": "node scripts/process-photowall-stickers.mjs love",
    "stickers:process-travel": "node scripts/process-photowall-stickers.mjs travel",
    "assets:webp": "node scripts/convert-static-images-to-webp.mjs",
    "figma-ui": "node scripts/generate-figma-ui-html.mjs",
    "stickers:process-night": "node scripts/process-photowall-stickers.mjs night",
    "audit:gate": "npm run build && npm run verify && npm run audit:deps && node scripts/verify-supabase-migrations.mjs"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "konva": "^10.3.0",
    "next": "^15.3.3",
    "onnxruntime-web": "^1.27.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.2.5",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
